# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Neon or Vercel Postgres)
# If omitted or empty, the app automatically falls back to an in-memory database seeded with demo data
DATABASE_URL=

# Authentication Secret (at least 32 characters for JOSE HS256 JWT)
AUTH_SECRET=super_secret_urbanmind_jwt_signing_key_at_least_32_characters_long

# Authority Invite Code required for city official registrations
AUTHORITY_INVITE_CODE=CHENNAI_GCC_2026
